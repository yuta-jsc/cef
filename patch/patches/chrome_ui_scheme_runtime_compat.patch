+}
+
+void RewriteLegacyChromeSchemesInValue(base::Value* value);
+
+void RewriteLegacyChromeSchemesInDict(base::DictValue* dict) {
+  for (auto it = dict->begin(); it != dict->end(); ++it) {
+    RewriteLegacyChromeSchemesInValue(&it->second);
+  }
+}
+
+void RewriteLegacyChromeSchemesInList(base::ListValue* list) {
+  for (base::Value& list_value : *list) {
+    RewriteLegacyChromeSchemesInValue(&list_value);
+  }
+}
+
+void RewriteLegacyChromeSchemesInValue(base::Value* value) {
+  if (std::string* string_value = value->GetIfString()) {
+    RewriteLegacyChromeSchemesIfNeeded(string_value);
+    return;
+  }
+
+  if (base::DictValue* dict_value = value->GetIfDict()) {
+    RewriteLegacyChromeSchemesInDict(dict_value);
+    return;
+  }
+
+  if (base::ListValue* list_value = value->GetIfList()) {
+    RewriteLegacyChromeSchemesInList(list_value);
+  }
+}
+
+void RewriteLegacyChromeSchemesInManifest(base::DictValue* manifest) {
+  if (!IsLegacyChromeSchemeRewriteEnabled()) {
+    return;
