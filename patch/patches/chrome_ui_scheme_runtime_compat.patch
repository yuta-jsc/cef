+  static const base::NoDestructor<std::string> kPrefix(
+      std::string(content::kChromeUIScheme) + "://");
+  return *kPrefix;
+}
+
+const std::string& GetCanonicalChromeUIUntrustedSchemePrefix() {
+  static const base::NoDestructor<std::string> kPrefix(
+      std::string(content::kChromeUIUntrustedScheme) + "://");
+  return *kPrefix;
+}
+
+void RewriteLegacyChromeSchemesIfNeeded(std::string* value) {
+  if (!IsLegacyChromeSchemeRewriteEnabled() ||
+      (value->find(kLegacyChromeUISchemePrefix) == std::string::npos &&
+       value->find(kLegacyChromeUIUntrustedSchemePrefix) ==
+           std::string::npos)) {
+    return;
+  }
+
+  base::ReplaceSubstringsAfterOffset(value, 0, kLegacyChromeUISchemePrefix,
+                                     GetCanonicalChromeUISchemePrefix());
+  base::ReplaceSubstringsAfterOffset(value, 0,
